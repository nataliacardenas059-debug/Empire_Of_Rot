<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Pos?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.empire_of_rot.CombatController"
            stylesheets="@style.css"
            style="-fx-background-color: linear-gradient(to bottom, #111111,#2b0000);">

    <top>
        <VBox alignment="CENTER" spacing="10">
                <Label text="EMPIRE OF ROT"
                       styleClass="titulo"/>
            <Separator/>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20">

            <HBox alignment="CENTER" spacing="80">

                    <VBox alignment="CENTER" spacing="8">
                        <Label text="JUGADOR"
                               styleClass="subtitulo"/>

                        <Label fx:id="LblJugador"
                               styleClass="label-info"/>

                        <Label fx:id="LblVidaJugador"
                               styleClass="label-vida"/>

                        <ProgressBar fx:id="barraVidaJugador"
                                     progress="1.0"
                                     prefWidth="250"/>

                        <Label fx:id="LblMunicion"
                               styleClass="label-puntos"/>

                        <Label fx:id="LblPuntos"
                               styleClass="label-puntos"/>
                    </VBox>

                   <VBox alignment="CENTER" spacing="8">
                       <Label text="ENEMIGO"
                              styleClass="subtitulo"/>

                       <Label fx:id="LblEnemigo"
                              styleClass="label-info"/>

                       <Label fx:id="LblVidaEnemigo"
                              styleClass="label-vida"/>

                       <ProgressBar fx:id="barraVidaEnemigo"
                                    progress="1.0"
                                    prefWidth="250"/>
                   </VBox>
            </HBox>
            <TextArea fx:id="txtCombate"
                      editable="false"
                      wrapText="true"
                      prefWidth="620"
                      prefHeight="220"
                      styleClass="area-combate"/>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER"
               spacing="20"
               style="-fx-padding: 20;">

            <Button text="Atacar"
                    onAction="#atacar"
                    styleClass="boton-atacar"/>


            <Button text="Habilidad Especial"
                    onAction="#habilidad"
                    styleClass="boton-especial"/>

            <Button text="Recargar arma"
                    onAction="#recargar"
                    styleClass="boton-recargar"/>

            <Button text="Huir"
                    onAction="#huir"
                   styleClass="boton-salir"/>
        </HBox>

    </bottom>

</BorderPane>