<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.TextArea?>
<VBox alignment="CENTER"
      spacing="20"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.empire_of_rot.MainMenuController"
      prefWidth="800"
      prefHeight="600"
      stylesheets="@style.css"
      style="-fx-background-color: linear-gradient(to bottom, #111111,#2b0000);">

    <Label text="Empire Of Rot"
           style="-fx-font-size: 36px;
                  -fx-text-fill: darkred;
                  -fx-font-weight: bold;"/>

    <VBox alignment="CENTER" spacing="5" prefWidth="250"
          style="-fx-background-color: rgba(0,0,0,0.5);
                 -fx-padding: 15;
                 -fx-background-radius: 10;">

        <Label text="🏆 TOP 5"
               style="-fx-text-fill: gold;
                      -fx-font-size: 22px;
                      -fx-font-weight: bold;"/>

        <Label fx:id = "lblTop1"
               styleClass="label-info"/>

        <Label fx:id = "lblTop2"
               styleClass="label-info"/>

        <Label fx:id = "lblTop3"
               styleClass="label-info"/>

        <Label fx:id = "lblTop4"
               styleClass="label-info"/>

        <Label fx:id = "lblTop5"
               styleClass="label-info"/>
    </VBox>

    <Button text="Jugar"
            onAction="#Jugar"
            style="-fx-font-size: 18px;
                    -fx-text-fill: white;
                    -fx-pref-width: 200;
                    -fx-background-color: linear-gradient(to bottom, #970101,#ff3d3d);
                   -fx-background-radius: 10;
                   -fx-font-weight: bold;"/>

    <Button text="Salir"
            onAction="#salir"
            style="-fx-font-size: 18px;
                    -fx-text-fill: white;
                    -fx-pref-width: 200;
                    -fx-background-color: linear-gradient(to bottom, #5c5c5c,#423f3f);
                   -fx-background-radius: 10;
                   -fx-font-weight: bold;"/>

</VBox>

