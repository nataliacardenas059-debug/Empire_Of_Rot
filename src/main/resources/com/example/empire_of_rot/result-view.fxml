<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Pos?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox  alignment="CENTER"
       spacing="15"
       xmlns="http://javafx.com/javafx"
       xmlns:fx="http://javafx.com/fxml"
       fx:controller="com.example.empire_of_rot.ResultController"
       prefWidth="800"
       prefHeight="600"
       stylesheets="@style.css"
       style="-fx-background-color: linear-gradient(to bottom, #111111,#2b0000);">

    <Label text="RESULTADO FINAL"
           style="-fx-font-size: 28px;
                  -fx-text-fill: #ba0030;
                  -fx-font-weight: bold;"/>

    <Label fx:id="LblResultado"
           style="-fx-font-size : 22px;
                  -fx-text-fill: gold;
                  -fx-font-weight: bold"/>

    <Label fx:id="LblJugador"
           style="-fx-text-fill: white;"/>

    <Label fx:id="LblPuntos"
           style="-fx-text-fill: gold;"/>

    <Label fx:id="LblEnemigos"
           style="-fx-text-fill: lightgreen;"/>

    <VBox alignment="CENTER" spacing="5" prefWidth="250"
          style="-fx-background-color: rgba(0,0,0,0.5);
                 -fx-padding: 15;
                 -fx-background-radius: 10;">

        <Label text="🏆 TOP 5"
               style="-fx-text-fill: gold;
                      -fx-font-size: 22px;
                      -fx-font-weight: bold;"/>

        <Label fx:id = "lblTop1"
               styleClass="label-info"/>

        <Label fx:id = "lblTop2"
               styleClass="label-info"/>

        <Label fx:id = "lblTop3"
               styleClass="label-info"/>

        <Label fx:id = "lblTop4"
               styleClass="label-info"/>

        <Label fx:id = "lblTop5"
               styleClass="label-info"/>
    </VBox>

    <Button text="Volver a Jugar"
            onAction="#volverAJugar"
            style="-fx-background-color: linear-gradient(to bottom, #8b0000,#3b0000);
                   -fx-background-radius: 10;
                    -fx-text-fill: white;
                   -fx-font-weight: bold;"/>

    <Button text="Salir"
            onAction="#salir"
            style="-fx-background-color: linear-gradient(to bottom, #e21717,#320b0b);
                   -fx-background-radius: 10;
                   -fx-text-fill: white;
                   -fx-font-weight: bold;"/>
</VBox>
